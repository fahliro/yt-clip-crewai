# ---- YouTube upload (OAuth desktop client, dari Google Cloud Console) ----
YT_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxx
YT_UPLOAD_CLIENT=your_oauth_client_id.apps.googleusercontent.com
YT_UPLOAD_SECRET=your_oauth_client_secret
YT_UPLOAD_TOKEN=your_refresh_token
# (opsional) fallback poll
YT_READ_TOKEN=

# ---- Transcription: Groq Whisper (sama persis seperti repo yt-clip-automation) ----
GROQ_API_KEY=gsk_xxx

# ---- Chat/agent LLM: OpenAI-compatible endpoint (sama persis seperti repo lama) ----
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL=your-model-name

# ---- Runtime ----
STATE_FILE=state.json
# video_id bisa di-override saat run manual: VIDEO_ID=
